# ── Ghostty Configuration ──────────────────────────────────────────────────────
# Role: High-performance GPU terminal renderer for Zellij & Wayland (Niri)

# Shell command
command = /usr/bin/zsh

# Appearance & Transparency
background-opacity = 0.85
background-blur = 10

# Wayland Clipboard Integration
clipboard-read = allow
clipboard-write = allow

# Keybindings: Ghostty keybinds are left clean to avoid conflicts with Zellij