{
  "active": true,
  "hubId": "host-cli",
  "name": "Host CLI Terminal Execution",
  "schema": "skill-1.0.0",
  "version": "1.0.0",
  "description": "Executes shell commands directly on the CachyOS Linux host via zsh. Supports full system PATH, Git operations, mise, cargo, and filesystem commands.",
  "author": "gidragir",
  "author_url": "https://github.com/gidragir/dotfiles",
  "license": "MIT",
  "setup_args": {},
  "examples": [
    {
      "prompt": "Run git status in dotfiles",
      "call": "{\"command\": \"git status\"}"
    },
    {
      "prompt": "Run git commit",
      "call": "{\"command\": \"git add . && git commit -m 'feat: update'\"}"
    }
  ],
  "entrypoint": {
    "file": "handler.js",
    "params": {
      "command": {
        "description": "The exact shell command line string to execute",
        "type": "string"
      },
      "cwd": {
        "description": "Optional working directory (defaults to /data/projects/dotfiles)",
        "type": "string"
      }
    }
  },
  "imported": true
}
