// Applications and desktop integrations
binds {
	// Knowledge and notes
Mod+N hotkey-overlay-title="Obsidian: New Note (Sticky/Workstation/Fleeting)" { spawn "bash" "-c" "~/.zsh/scripts/obsidian-create-note.sh"; }
Mod+Alt+N hotkey-overlay-title="Obsidian: New Note (Sticky/Workstation/Fleeting)" { spawn "bash" "-c" "~/.zsh/scripts/obsidian-create-note.sh"; }
Mod+I hotkey-overlay-title="Insert Path/Note: Obsidian & Projects" { spawn "bash" "-c" "~/.zsh/scripts/path-picker-dmenu.sh"; }
Mod+Shift+O hotkey-overlay-title="Obsidian: Companion Hub" { spawn-sh "qs -c noctalia-shell ipc call plugin:obsidian toggle"; }
Mod+Alt+F hotkey-overlay-title="Obsidian: Search Notes (Noctalia)" { spawn "bash" "-c" "obsidian-helper.sh search-notes"; }
Mod+Alt+T hotkey-overlay-title="Obsidian: Explore Tags (Noctalia)" { spawn "bash" "-c" "obsidian-helper.sh explore-tags"; }

	// Clipboard and discovery
Mod+V hotkey-overlay-title="Clipboard History: Noctalia" { spawn-sh "qs -c noctalia-shell ipc call launcher clipboard"; }
Mod+Z hotkey-overlay-title="Open Zoxide Directory in Antigravity IDE" { spawn "bash" "-c" "res=$(zoxide query -l | noctalia-dmenu.sh -p 'Zoxide:'); [ -n \"$res\" ] && antigravity-ide \"$res\""; }
Mod+X hotkey-overlay-title="Open Workspace in Antigravity IDE" { spawn "bash" "-c" "res=$(ls ~/workspaces | noctalia-dmenu.sh -p 'Workspace:'); [ -n \"$res\" ] && antigravity-ide ~/workspaces/\"$res\""; }

	// AI assistants
Mod+A hotkey-overlay-title="AI Assistant: AnythingLLM" { spawn "bash" "-c" "anythingllm-assistant-toggle.sh"; }
Mod+Alt+A hotkey-overlay-title="AI Assistant: Khoj WebApp" { spawn "bash" "-c" "khoj-toggle.sh"; }
Mod+Ctrl+A hotkey-overlay-title="AI Assistant: Local AI Hub" { spawn "bash" "-c" "ai-launcher.sh"; }

	// Development and terminal tools
Mod+Shift+A { spawn "nu" "-c" "source $nu.config-path; open-focus-id code code"; }
Mod+Return hotkey-overlay-title="Open Terminal: Ghostty" { spawn "ghostty" "-e" "zellij"; }
Mod+Shift+Escape { spawn "ghostty" "-e" "btop"; }
Mod+E { spawn "ghostty" "-e" "spf"; }

	// Desktop and session controls
Mod+CTRL+Return hotkey-overlay-title="Open App Launcher: noctalia launcher" { spawn-sh "qs -c noctalia-shell ipc call launcher toggle"; }
Mod+B hotkey-overlay-title="Open Browser: vivaldi" { spawn "vivaldi"; }
Mod+F1 hotkey-overlay-title="CoolerControl: Toggle Mode" { spawn-sh "cooler-toggle.sh"; }
Mod+ALT+L hotkey-overlay-title="Lock Screen: noctalia lock" { spawn-sh "qs -c noctalia-shell ipc call media pause && qs -c noctalia-shell ipc call lockScreen lock"; }
Mod+Shift+Q hotkey-overlay-title="Session Menu: noctalia sessionMenu" { spawn-sh "qs -c noctalia-shell ipc call sessionMenu toggle"; }
Mod+Shift+0 { show-hotkey-overlay; }
}
