    window-rule {
        geometry-corner-radius 10 // Set every window radius to 20
        clip-to-geometry true
    }

    window-rule {
        match app-id="vivaldi"
        exclude title="[Ss]ettings"
        open-maximized-to-edges true
    }

    window-rule {
        match title="(?i)settings"
        open-floating true
    }

     // if you use steam you will probably like these
    window-rule {
        match app-id="steam"
        exclude title=r#"^[Ss]team$"#
        open-floating true
    }

    window-rule {
       match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
       default-floating-position x=10 y=10 relative-to="bottom-right"
       open-focused false
    }

    window-rule {
        match app-id="^steam_app_default$"
        open-fullscreen true
        geometry-corner-radius 0
        focus-ring { off; }
        border { off; }
    }

    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }

    window-rule {
        match app-id="rofi"
        open-floating true
        default-column-width { fixed 350; }
    }

    window-rule {
        match app-id="org.gnome.Nautilus"
        open-floating true
    }

    window-rule {
        match app-id="ferdium"
        open-maximized-to-edges true
    }

    window-rule {
        match app-id="imv"
        open-floating true
    }

    window-rule {
        match title="Picture in picture"
        open-floating true
    }

    window-rule {
        match app-id=""
        open-floating true
    }
    window-rule {
        match title=""
        open-floating true
    }

    include optional=true "env/rules.kdl"