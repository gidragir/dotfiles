// ────────────── Output Configuration (PC / desktop) ──────────────
// Linked by ygg to ~/.config/niri/cfg/display.kdl for scope `pc`.
// Run `niri msg outputs` to get the correct name for your displays.
// https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs

// output "DP-2" {
//     mode "1920x1080@143.981"
//     focus-at-startup
//     scale 1
// }

output "DP-2" {
    mode "3440x1440@143.965"
    variable-refresh-rate
    scale 1
}

output "HDMI-A-1" {
    mode "1920x1080@143.981"
    scale 1
}

include optional=true "../local.kdl"
