layout {
    gaps 8
    center-focused-column "on-overflow"
    always-center-single-column

    background-color "transparent"

    default-column-width { proportion 0.5; }

    preset-column-widths {
        proportion 0.25     // 1/4 (мониторинг, мессенджер)
        proportion 0.33333  // 1/3 (трехколоночный сетап)
        proportion 0.5      // 1/2 (классический dual-pane)
        proportion 0.66667  // 2/3 (основная рабочая зона IDE / DevTools)
        proportion 0.75     // 3/4
    }

    struts {}

    focus-ring {
        width 1.5
        active-color "#7fc8ff"
        inactive-color "#505050"
    }
}
