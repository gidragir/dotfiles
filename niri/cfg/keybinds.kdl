// Keybindings are grouped by purpose in the files below.

recent-windows {
	binds {
		Alt+Tab { next-window; }
		Alt+Shift+Tab { previous-window; }
	}
}

include "./keybinds/apps.kdl"
include "./keybinds/media.kdl"
include "./keybinds/navigation.kdl"
include "./keybinds/workspaces.kdl"
include "./keybinds/layout-system.kdl"

include optional=true "./env/keybinds.kdl"