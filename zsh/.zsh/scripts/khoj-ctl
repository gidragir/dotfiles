#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# Script  : khoj-ctl
# Purpose : CLI control & interaction utility for Khoj AI assistant
# =============================================================================

KHOJ_HOST="${KHOJ_HOST:-http://127.0.0.1:42110}"
CONTAINER_NAME="khoj"

usage() {
    cat << 'EOF'
Usage: khoj-ctl <command> [arguments...]

Commands:
  status             Show status of Khoj, Ollama, Headroom, Postgres and indexed notes
  chat <query>       Send a query to Khoj chat endpoint and display response + references
  search <query>     Semantic & tag search across Obsidian notes via Khoj search API
  tags [tag]         Search or browse Obsidian notes by tag (uses khoj-tags)
  sync               Trigger sync and re-indexing of notes in Khoj
  reindex            Wipe old embeddings and perform full re-indexing of notes
  logs [-f] [N]      View or follow Khoj container logs (default: last 50 lines)
  restart            Restart Khoj container and verify health
  help               Show this help message

Options for chat:
  --model, -m <name> Override model (default: qwen2.5:14b)
  --agent, -a <slug> Target agent (e.g. khoj, obsidian-code, obsidian-analyst)
  --raw              Output raw JSON response

Examples:
  khoj-ctl status
  khoj-ctl chat "найди заметки по тегу mind_note"
  khoj-ctl search "mind_note"
  khoj-ctl tags mind_note
  khoj-ctl sync
  khoj-ctl reindex
EOF
}

cmd_status() {
    echo -e "\033[1;36m=== Khoj AI Ecosystem Status ===\033[0m"
    
    # 1. Ollama
    if systemctl --user is-active ollama.service &>/dev/null; then
        echo -e "  \033[1;32m✓\033[0m Ollama Service        : Active (:11434)"
    elif curl -sf http://127.0.0.1:11434/api/tags &>/dev/null; then
        echo -e "  \033[1;32m✓\033[0m Ollama HTTP           : Responsive (:11434)"
    else
        echo -e "  \033[1;31m✗\033[0m Ollama                : Inactive / Unreachable"
    fi

    # 2. Headroom
    if systemctl --user is-active headroom-default.service &>/dev/null; then
        echo -e "  \033[1;32m✓\033[0m Headroom Proxy        : Active (:8787)"
    else
        echo -e "  \033[1;33m-\033[0m Headroom Proxy        : Inactive (:8787)"
    fi

    # 3. Docker Containers
    local khoj_status postgres_status
    khoj_status=$(docker inspect -f '{{.State.Status}} (healthy: {{.State.Health.Status}})' "$CONTAINER_NAME" 2>/dev/null || echo "not running")
    postgres_status=$(docker inspect -f '{{.State.Status}} (healthy: {{.State.Health.Status}})' "khoj-postgres" 2>/dev/null || echo "not running")
    
    if [[ "$khoj_status" == *"healthy"* ]]; then
        echo -e "  \033[1;32m✓\033[0m Khoj Container        : $khoj_status"
    else
        echo -e "  \033[1;31m✗\033[0m Khoj Container        : $khoj_status"
    fi

    if [[ "$postgres_status" == *"healthy"* ]]; then
        echo -e "  \033[1;32m✓\033[0m Postgres pgvector     : $postgres_status"
    else
        echo -e "  \033[1;31m✗\033[0m Postgres pgvector     : $postgres_status"
    fi

    # 4. Khoj Health Endpoint
    if curl -sf "${KHOJ_HOST}/api/health" &>/dev/null; then
        echo -e "  \033[1;32m✓\033[0m Khoj HTTP API         : OK (${KHOJ_HOST})"
    else
        echo -e "  \033[1;31m✗\033[0m Khoj HTTP API         : Unreachable (${KHOJ_HOST})"
    fi

    # 5. DB & Model Stats
    if docker ps -q -f name="$CONTAINER_NAME" | grep -q .; then
        local model_stats
        model_stats=$(docker exec -i "$CONTAINER_NAME" python3 -c '
import os, django
os.environ.setdefault("DJANGO_SETTINGS_MODULE", "khoj.app.settings")
django.setup()
from khoj.database.models import SearchModelConfig, ChatModel, Entry, KhojUser
sm = SearchModelConfig.objects.filter(name="default").first() or SearchModelConfig.objects.first()
bi = sm.bi_encoder if sm else "unknown"
cm = ChatModel.objects.filter(name="qwen2.5:14b").first()
max_p = cm.max_prompt_size if cm else "default"
print(f"bi_encoder={bi}|max_prompt={max_p}")
for u in KhojUser.objects.all():
    c = Entry.objects.filter(user=u).count()
    if c > 0:
        print(f"entries={u.username}: {c} notes indexed")
' 2>/dev/null || true)
        if [ -n "$model_stats" ]; then
            local bi_val max_p_val
            bi_val=$(echo "$model_stats" | grep '^bi_encoder=' | cut -d= -f2 | cut -d'|' -f1)
            max_p_val=$(echo "$model_stats" | grep '^bi_encoder=' | sed -n 's/.*max_prompt=\(.*\)/\1/p')
            echo -e "  \033[1;34mℹ\033[0m Bi-Encoder (Search)   : $bi_val"
            echo -e "  \033[1;34mℹ\033[0m LLM Context Prompt    : ${max_p_val} tokens"
            echo "$model_stats" | { grep '^entries=' || true; } | while read -r line; do
                if [ -n "$line" ]; then
                    local estats="${line#entries=}"
                    echo -e "  \033[1;34mℹ\033[0m Knowledge Base Entries: $estats"
                fi
            done
        fi
    fi
}

cmd_chat() {
    local query=""
    local model=""
    local agent=""
    local raw=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --model|-m)
                model="$2"
                shift 2
                ;;
            --agent|-a)
                agent="$2"
                shift 2
                ;;
            --raw)
                raw=true
                shift
                ;;
            *)
                if [ -z "$query" ]; then
                    query="$1"
                else
                    query="$query $1"
                fi
                shift
                ;;
        esac
    done

    if [ -z "$query" ]; then
        echo "Error: Query required. Usage: khoj-ctl chat <query>" >&2
        exit 1
    fi

    # Build JSON payload
    local payload
    payload=$(python3 -c '
import json, sys
data = {"q": sys.argv[1], "stream": False}
if sys.argv[2]: data["model"] = sys.argv[2]
if sys.argv[3]: data["agent"] = sys.argv[3]
print(json.dumps(data))
' "$query" "$model" "$agent")

    local response
    response=$(curl -sf -X POST "${KHOJ_HOST}/api/chat" \
        -H "Content-Type: application/json" \
        -d "$payload" 2>/dev/null || true)

    if [ -z "$response" ]; then
        echo "Error: Failed to connect or received empty response from Khoj at ${KHOJ_HOST}/api/chat" >&2
        exit 1
    fi

    if [ "$raw" = true ]; then
        echo "$response" | python3 -m json.tool
        return 0
    fi

    # Format nicely
    python3 -c '
import sys, json

try:
    data = json.loads(sys.stdin.read())
except Exception as e:
    print("Failed to parse JSON response:", e)
    sys.exit(1)

resp_text = data.get("response", "").strip()
refs = data.get("references", {})
ctx_list = refs.get("context", []) if isinstance(refs, dict) else []

print("\033[1;32m=== Khoj Response ===\033[0m\n")
print(resp_text)
print("\n\033[1;34m=== Context & References ===\033[0m")
print(f"Total References: {len(ctx_list)}")

if ctx_list:
    for i, item in enumerate(ctx_list[:15], 1):
        f = item.get("file", "unknown")
        q = item.get("query", "")
        print(f"  {i}. {f} ({q})")
    if len(ctx_list) > 15:
        print(f"  ... and {len(ctx_list) - 15} more")

usage = data.get("usage", {})
if usage:
    in_tok = usage.get("input_tokens", 0)
    out_tok = usage.get("output_tokens", 0)
    print(f"\n\033[1;30m[Tokens: in={in_tok}, out={out_tok}]\033[0m")
' <<< "$response"
}

cmd_search() {
    local query="$*"
    if [ -z "$query" ]; then
        echo "Error: Search query required. Usage: khoj-ctl search <query>" >&2
        exit 1
    fi

    local encoded_query
    encoded_query=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))" "$query")

    local response
    response=$(curl -sf "${KHOJ_HOST}/api/search?q=${encoded_query}&n=20" 2>/dev/null || true)

    if [ -z "$response" ]; then
        echo "Error: Failed to connect to Khoj search at ${KHOJ_HOST}/api/search" >&2
        exit 1
    fi

    python3 -c '
import sys, json

try:
    data = json.loads(sys.stdin.read())
except Exception as e:
    print("Invalid response:", e)
    sys.exit(1)

if not data:
    print("No matching notes found.")
    sys.exit(0)

print(f"\033[1;36mFound {len(data)} results for query:\033[0m\n")
for i, item in enumerate(data, 1):
    additional = item.get("additional") or {}
    file_path = additional.get("file") or item.get("entry", "").splitlines()[0]
    score = item.get("score", 0.0)
    print(f"\033[1;32m{i}.\033[0m \033[1m{file_path}\033[0m \033[1;30m(score: {score:.3f})\033[0m")
' <<< "$response"
}

cmd_tags() {
    if command -v khoj-tags >/dev/null 2>&1; then
        khoj-tags "$@"
    else
        "$(dirname "$0")/khoj-tags" "$@"
    fi
}

cmd_sync() {
    echo "Triggering Khoj sync / update..."
    if docker ps -q -f name="$CONTAINER_NAME" | grep -q .; then
        docker exec -i "$CONTAINER_NAME" python3 -c '
import khoj.main
from khoj.utils.fs_syncer import sync_filesystem_notes
sync_filesystem_notes()
print("✓ Filesystem sync triggered successfully")
' 2>/dev/null || {
            echo "Direct python sync fallback: reloading container..."
            docker restart "$CONTAINER_NAME"
        }
        echo "Sync complete."
    else
        echo "Error: Khoj container is not running." >&2
        exit 1
    fi
}

cmd_reindex() {
    echo -e "\033[1;33mTriggering full re-indexing (purging old embeddings)...\033[0m"
    if docker ps -q -f name="$CONTAINER_NAME" | grep -q .; then
        docker exec -i "$CONTAINER_NAME" python3 -c '
import os, django
os.environ.setdefault("DJANGO_SETTINGS_MODULE", "khoj.app.settings")
django.setup()
from khoj.database.models import Entry
deleted_count, _ = Entry.objects.all().delete()
print(f"Purged {deleted_count} stale entries.")
'
        curl -s "${KHOJ_HOST}/api/update?force=true" >/dev/null 2>&1 || true
        echo -e "\033[1;32m✓ Full re-index scheduled in Khoj.\033[0m"
    else
        echo "Error: Khoj container is not running." >&2
        exit 1
    fi
}

cmd_logs() {
    local follow=false
    local lines="50"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--follow)
                follow=true
                shift
                ;;
            *)
                if [[ "$1" =~ ^[0-9]+$ ]]; then
                    lines="$1"
                fi
                shift
                ;;
        esac
    done

    if [ "$follow" = true ]; then
        docker logs -f --tail "$lines" "$CONTAINER_NAME"
    else
        docker logs --tail "$lines" "$CONTAINER_NAME"
    fi
}

cmd_restart() {
    echo "Restarting Khoj container..."
    docker restart "$CONTAINER_NAME"
    echo -n "Waiting for Khoj health check..."
    for i in {1..30}; do
        if curl -sf "${KHOJ_HOST}/api/health" &>/dev/null; then
            echo -e " \033[1;32mOK!\033[0m"
            return 0
        fi
        sleep 1
        echo -n "."
    done
    echo -e " \033[1;31mTimeout waiting for healthy state.\033[0m"
    return 1
}

# Main routing
if [ $# -eq 0 ]; then
    usage
    exit 0
fi

SUBCOMMAND="$1"
shift

case "$SUBCOMMAND" in
    status)
        cmd_status "$@"
        ;;
    chat)
        cmd_chat "$@"
        ;;
    search)
        cmd_search "$@"
        ;;
    tags)
        cmd_tags "$@"
        ;;
    sync)
        cmd_sync "$@"
        ;;
    reindex)
        cmd_reindex "$@"
        ;;
    logs)
        cmd_logs "$@"
        ;;
    restart)
        cmd_restart "$@"
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo "Unknown command: $SUBCOMMAND" >&2
        usage
        exit 1
        ;;
esac
