#!/usr/bin/env bash
# Cycle through CoolerControl modes: Quiet -> Work -> Gaming -> Quiet

TOKEN_FILE="${COOLERCONTROL_TOKEN_FILE:-$HOME/.config/coolercontrol/token}"
BASE_URL="${COOLERCONTROL_BASE_URL:-https://127.0.0.1:11987}"

token="${COOLERCONTROL_TOKEN:-$(cat "$TOKEN_FILE" 2>/dev/null)}"
if [[ -z "$token" ]]; then
  notify-send -a "CoolerControl" -u critical "CoolerControl" "Error: token not found"
  exit 1
fi

modes_json=$(curl -k -s -H "Authorization: Bearer $token" "$BASE_URL/modes" 2>/dev/null)
active_json=$(curl -k -s -H "Authorization: Bearer $token" "$BASE_URL/modes-active" 2>/dev/null)

active_uid=$(echo "$active_json" | jq -r '.current_mode_uid' 2>/dev/null)
current_name=$(echo "$modes_json" | jq -r ".modes[] | select(.uid==\"$active_uid\") | .name" 2>/dev/null)

case "$current_name" in
  "Quiet")
    NEXT_NAME="Work"
    ICON="system-run"
    EMOJI="💼"
    ;;
  "Work")
    NEXT_NAME="Gaming"
    ICON="applications-games"
    EMOJI="🎮"
    ;;
  *)
    NEXT_NAME="Quiet"
    ICON="audio-headphones"
    EMOJI="🤫"
    ;;
esac

next_uid=$(echo "$modes_json" | jq -r ".modes[] | select(.name==\"$NEXT_NAME\") | .uid" 2>/dev/null)

if [[ -n "$next_uid" && "$next_uid" != "null" ]]; then
  http_code=$(curl -k -s -o /dev/null -w '%{http_code}' -X POST \
    -H "Authorization: Bearer ${token}" \
    "${BASE_URL}/modes-active/${next_uid}")
    
  if [[ "$http_code" == "200" ]]; then
    notify-send -a "CoolerControl" -i "$ICON" "CoolerControl" "Mode: ${NEXT_NAME} ${EMOJI}"
  else
    notify-send -a "CoolerControl" -u critical "CoolerControl" "Failed to switch to ${NEXT_NAME} (HTTP ${http_code})"
  fi
else
  notify-send -a "CoolerControl" -u critical "CoolerControl" "UID for mode ${NEXT_NAME} not found"
fi
