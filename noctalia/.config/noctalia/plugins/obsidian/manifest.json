{
  "id": "obsidian",
  "name": "Obsidian Companion",
  "version": "1.0.0",
  "minNoctaliaVersion": "3.9.0",
  "author": "gidragir",
  "license": "MIT",
  "repository": "https://github.com/gidragir/noctalia-obsidian",
  "description": "Seamless Obsidian vault companion with live tasks indicator, quick capture, tag browsing, and sync.",
  "tags": ["Productivity", "Notes", "Obsidian", "Tasks", "Utility"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "vaultPath": "/data/obsidian",
      "dailyFolder": "DAILY",
      "dailyFormat": "YYYY-MM-DD",
      "inboxFile": "INBOX.md",
      "preferredEditor": "neovim",
      "showBadge": true,
      "badgeMode": "pending",
      "refreshIntervalSec": 15,
      "syncService": "rclone-obsidian-sync.service",
      "panelPosition": "follow_launcher"
    }
  }
}
