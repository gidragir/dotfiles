    window-rule {
        geometry-corner-radius 10 // Set every window radius to 20
        clip-to-geometry true
    }

    window-rule {
        match app-id=r#"^vivaldi-stable$"#
        exclude title="[Ss]ettings"
        exclude title=r#"127\.0\.0\.1"#
        exclude title=r#"(?i)khoj"#
        default-column-width { proportion 0.5; }
    }

    // Terminals: 1/3 or 1/2 of ultrawide screen
    window-rule {
        match app-id=r#"^(ghostty|com\.mitchellh\.ghostty|Alacritty|kitty)$"#
        default-column-width { proportion 0.5; }
    }

    // Messengers & Communication: 1/4 of ultrawide screen
    window-rule {
        match app-id=r#"^(telegramdesktop|org\.telegram\.desktop|discord|vesktop|slack)$"#
        default-column-width { proportion 0.25; }
    }

    window-rule {
        match title="(?i)settings"
        open-floating true
    }

     // if you use steam you will probably like these
    window-rule {
        match app-id="steam"
        exclude title=r#"^[Ss]team$"#
        open-floating true
    }

    window-rule {
       match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
       default-floating-position x=10 y=10 relative-to="bottom-right"
       open-focused false
    }

    // Steam games & Gamescope: pure fullscreen without borders or rounded corners
    window-rule {
        match app-id=r#"^(gamescope|steam_app_.*)$"#
        open-fullscreen true
        geometry-corner-radius 0
        focus-ring { off; }
        border { off; }
    }

    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }

    window-rule {
        match app-id="rofi"
        open-floating true
        default-column-width { fixed 350; }
    }

    window-rule {
        match app-id="org.gnome.Nautilus"
        open-floating true
    }

    window-rule {
        match app-id="anythingllm-desktop"
        open-floating true
        default-floating-position x=485 y=100 relative-to="top-left"
        default-column-width { fixed 950; }
        default-window-height { fixed 850; }
    }

    window-rule {
        match app-id=r#"^(pear-desktop|youtube-music|com\.github\.th[-_]ch\.youtube[-_]music)$"#
        open-floating true
        default-floating-position x=485 y=100 relative-to="top-left"
        default-column-width { fixed 1200; }
        default-window-height { fixed 850; }
    }

    window-rule {
        match title=r#"(?i)YouTube Music"#
        exclude app-id=r#"^(antigravity|code)$"#
        open-floating true
        default-floating-position x=485 y=100 relative-to="top-left"
        default-column-width { fixed 1200; }
        default-window-height { fixed 850; }
    }

    window-rule {
        match app-id=r#"^vivaldi-127\.0\.0\.1"#
        match title=r#"127\.0\.0\.1"#
        match title=r#"(?i)Khoj"#
        open-floating true
        default-floating-position x=485 y=100 relative-to="top-left"
        default-column-width { fixed 950; }
        default-window-height { fixed 850; }
    }

    window-rule {
        match title=r#"^(Khoj Quick Chat|Khoj Tags Browser|AI Stack Status|Anything-CTL|Obsidian Note:.*)$"#
        open-floating true
        default-floating-position x=485 y=150 relative-to="top-left"
        default-column-width { fixed 950; }
        default-window-height { fixed 750; }
    }

    window-rule {
        match app-id="ferdium"
        default-column-width { proportion 0.33333; }
    }

    window-rule {
        match app-id="imv"
        open-floating true
    }

    window-rule {
        match title="Picture in picture"
        open-floating true
    }

    window-rule {
        match app-id="^$" title="^$"
        open-floating true
        open-focused false
        default-floating-position x=8 y=8 relative-to="bottom-right"
    }

    include optional=true "env/rules.kdl"