# ── Systemd User Session Secrets ──────────────────────────────────────────────
# Rendered by chezmoi (private_99-secrets.conf.tmpl) from ~/.config/chezmoi/secrets.toml
# Access permissions: 0600 (-rw-------)
{{- $secretsFile := joinPath .chezmoi.homeDir ".config/chezmoi/secrets.toml" }}
{{- if stat $secretsFile }}
{{-   $secrets := (include $secretsFile | fromToml) }}
{{-   if hasKey $secrets "env" }}
{{-     range $key, $val := $secrets.env }}
{{ $key }}={{ $val }}
{{-     end }}
{{-   end }}
{{- end }}
