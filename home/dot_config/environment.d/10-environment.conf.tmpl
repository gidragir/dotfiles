# ── Systemd User Session Environment ──────────────────────────────────────────
# Rendered by chezmoi (10-environment.conf.tmpl) — Single Source of Truth
# Read by systemd-environment-d-generator for all systemd user units & Wayland

# ── XDG Base Directory Specification ──────────────────────────────────────────
XDG_CONFIG_HOME=${HOME}/.config
XDG_DATA_HOME=${HOME}/.local/share
XDG_CACHE_HOME=${HOME}/.cache
XDG_STATE_HOME=${HOME}/.local/state

# ── Shell, Package Managers & PATH Configuration ──────────────────────────────
SHELL=/usr/bin/zsh
PNPM_HOME=/data/projects/.pnpm-store
PATH=${HOME}/.local/share/mise/shims:${HOME}/.local/bin:/data/projects/.pnpm-store:/data/projects/.pnpm-store/bin:${HOME}/.zsh/scripts{{- if eq .chassis "desktop" }}:/data/projects/ai-dotfiles/scripts{{- end }}:${PATH}

# ── Tool Caches & System Defaults ─────────────────────────────────────────────
SCCACHE_DIR=/data/projects/.sccache
UV_CACHE_DIR=/data/projects/.uv-cache
KUBECONFIG=${HOME}/.kube/config
FZF_BASE=/usr/share/fzf
EDITOR=nvim
VISUAL=nvim
{{- if eq .chassis "desktop" }}

# ── Headroom Context Optimization Proxy & FX CLI (Desktop AI Stack) ───────────
ANTHROPIC_BASE_URL=http://127.0.0.1:8787
OPENAI_BASE_URL=http://127.0.0.1:8787/v1
OPENAI_API_KEY=ollama
FX_PROVIDER=openai
FX_MODEL=qwen2.5-coder:14b
{{- end }}

# ── Locale & Regional Overrides ───────────────────────────────────────────────
LANG=en_US.UTF-8
LC_TIME=en_US.UTF-8
LC_NUMERIC=en_US.UTF-8
LC_MONETARY=en_US.UTF-8
LC_PAPER=en_US.UTF-8
LC_NAME=en_US.UTF-8
LC_ADDRESS=en_US.UTF-8
LC_TELEPHONE=en_US.UTF-8
LC_MEASUREMENT=en_US.UTF-8
LC_IDENTIFICATION=en_US.UTF-8
