#!/usr/bin/env bash
# Wallpaper Engine Runner for Niri / Wayland
set -euo pipefail

CONFIG_FILE="${HOME}/.config/wallpaper-engine/config.json"
WORKSHOP_DIR="${HOME}/.local/share/Steam/steamapps/workshop/content/431960"

# Find Wallpaper Engine assets directory
DEFAULT_ASSETS="${HOME}/Games/SteamLibrary/common/wallpaper_engine/assets"
if [ ! -d "$DEFAULT_ASSETS" ]; then
    DEFAULT_ASSETS="${HOME}/.local/share/Steam/steamapps/common/wallpaper_engine/assets"
fi

ASSETS_DIR="$DEFAULT_ASSETS"
WALLPAPER_ID=""
FPS=60
EXTRA_ARGS=()

if [ -f "$CONFIG_FILE" ] && command -v jq &>/dev/null; then
    ASSETS_DIR=$(jq -r '.assets_dir // "'"$DEFAULT_ASSETS"'"' "$CONFIG_FILE")
    WALLPAPER_ID=$(jq -r '.default_wallpaper_id // ""' "$CONFIG_FILE")
    FPS=$(jq -r '.fps // 60' "$CONFIG_FILE")
    SILENT=$(jq -r '.silent // true' "$CONFIG_FILE")
    if [ "$SILENT" = "true" ]; then
        EXTRA_ARGS+=("--silent")
    fi
fi

# Allow overriding wallpaper ID via command argument (handles full paths and preview files from Waypaper)
if [ $# -gt 0 ]; then
    ARG_PATH="$1"
    shift
    if [ -f "$ARG_PATH" ]; then
        NEW_ID=$(basename "$(dirname "$ARG_PATH")")
    else
        NEW_ID=$(basename "$ARG_PATH")
    fi

    # Save selected wallpaper ID to config.json and restart background service
    if [ -n "$NEW_ID" ] && [ -d "$WORKSHOP_DIR/$NEW_ID" ]; then
        if command -v jq &>/dev/null && [ -f "$CONFIG_FILE" ]; then
            jq --arg id "$NEW_ID" '.default_wallpaper_id = $id' "$CONFIG_FILE" > /tmp/w_cfg.json && mv /tmp/w_cfg.json "$CONFIG_FILE" || true
        fi
        echo "🔄 Changing wallpaper ID to $NEW_ID..."
        systemctl --user restart wallpaper-engine.service 2>/dev/null || true
        exit 0
    fi
fi

if [ -z "$WALLPAPER_ID" ] || [ "$WALLPAPER_ID" = "{wallpaper}" ] || [ ! -d "$WORKSHOP_DIR/$WALLPAPER_ID" ]; then
    # Find first available workshop item if invalid or unspecified ID
    FIRST_ITEM=$(fd . "$WORKSHOP_DIR" --min-depth 1 --max-depth 1 --type d 2>/dev/null | head -n 1 || echo "")
    if [ -n "$FIRST_ITEM" ]; then
        WALLPAPER_ID=$(basename "$FIRST_ITEM")
        echo "ℹ️ No valid wallpaper ID configured. Using found item: $WALLPAPER_ID"
    else
        echo "❌ No wallpaper ID provided and no workshop wallpapers found in $WORKSHOP_DIR."
        echo "   Please download wallpapers via Steam Wallpaper Engine (App 431960) or place wallpaper folders into:"
        echo "   $WORKSHOP_DIR"
        echo "   Usage: wallpaper-engine-runner <wallpaper_id_or_folder_name>"
        exit 1
    fi
fi

# Detect active Niri monitor outputs to attach wallpapers to desktop layer shell
SCREEN_ARGS=()
if command -v niri &>/dev/null; then
    while read -r output; do
        if [ -n "$output" ]; then
            SCREEN_ARGS+=("--screen-root" "$output")
        fi
    done < <(niri msg outputs 2>/dev/null | rg '^Output "' | sed -E 's/.*\((.*)\)/\1/')
fi

if [ ${#SCREEN_ARGS[@]} -eq 0 ]; then
    SCREEN_ARGS=("--layer" "background")
else
    SCREEN_ARGS+=("--layer" "background")
fi

echo "🚀 Starting linux-wallpaperengine on outputs (${SCREEN_ARGS[*]}) for wallpaper ID: $WALLPAPER_ID..."
exec linux-wallpaperengine \
    --assets-dir "$ASSETS_DIR" \
    --fps "$FPS" \
    --fullscreen-pause-only-active \
    "${SCREEN_ARGS[@]}" \
    "${EXTRA_ARGS[@]}" \
    "$@" \
    "$WALLPAPER_ID"
